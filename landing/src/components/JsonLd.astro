---
/**
 * Centralised JSON-LD structured data injection.
 *
 * Always emits two graphs:
 *   1. Organization  — describes the publishing entity (Compass CC)
 *   2. WebSite       — describes this site as a publication
 *
 * Optionally accepts an extra `graph` prop for page-specific schemas
 * (Article, BreadcrumbList, FAQPage…) when needed later.
 *
 * Renders inside a single <script type="application/ld+json"> using
 * `@graph` aggregation per schema.org best practice.
 */
import { type Locale, t } from '@/i18n/strings';

interface Props {
  locale: Locale;
  extraGraph?: Array<Record<string, unknown>>;
}

const { locale, extraGraph = [] } = Astro.props;
const copy = t(locale);
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://com-compass.com';

const organization = {
  '@type': 'Organization',
  '@id': `${siteUrl}/#organization`,
  name: 'Compass CC',
  alternateName: 'Commodities Compass',
  url: siteUrl,
  logo: {
    '@type': 'ImageObject',
    url: `${siteUrl}/compass-icon.png`,
    width: 1024,
    height: 1024,
  },
  description: copy.meta.description,
  foundingDate: '2025',
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: 'contact@com-compass.com',
    availableLanguage: ['French', 'English'],
  },
  sameAs: [
    // TODO: add LinkedIn company URL when available
  ],
  knowsAbout: ['ICE cocoa futures', 'commodity markets', 'cocoa supply chain', 'market intelligence'],
};

// WebSite schema — Google uses `name` for the SERP "site name" display
// (the string shown next to the favicon in search results). `alternateName`
// helps Google recognise "Commodities Compass" as a variant. Site name
// replaces the raw domain in Google SERPs in ~1-4 weeks after Google
// trusts the signals on a new domain.
// Ref: https://developers.google.com/search/docs/appearance/site-names
// NB: no `potentialAction` (SearchAction) — the landing is fully static
// with no search endpoint; a false SearchAction would be penalised.
const website = {
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: siteUrl,
  name: 'Compass CC',
  alternateName: ['Commodities Compass', 'com-compass'],
  description: copy.meta.description,
  publisher: { '@id': `${siteUrl}/#organization` },
  inLanguage: locale === 'fr' ? 'fr-FR' : 'en-US',
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...extraGraph],
};
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)}></script>

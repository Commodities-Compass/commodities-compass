---
/**
 * Phase 1 placeholder.
 *
 * Phase 1 only proves the Astro + Tailwind + i18n + brand-font pipeline
 * works end-to-end. The real sections (Bento signal, Method, Audio, Contact)
 * land in Phase 2 — they will replace this component one-by-one, mirroring
 * the structure of mockup/landing/option-D-editorial-glass.html.
 */
interface Props {
  roman: string;
  title: string;
  hint?: string;
}

const { roman, title, hint } = Astro.props;
---

<section class="border-b border-rule">
  <div class="mx-auto w-full max-w-[1280px] px-6 py-20 lg:px-10 lg:py-24">
    <div class="flex items-baseline gap-6 border-b border-rule pb-4">
      <span class="font-display text-3xl font-light italic text-ink-light">{roman}</span>
      <h2 class="font-sans text-sm font-semibold uppercase tracking-[0.18em] text-ink">
        {title}
      </h2>
    </div>
    <p class="deck mt-8 text-lg">
      {hint ?? 'Phase 2 — to come.'}
    </p>
  </div>
</section>

---
import { type Locale, t, pathFor } from '@/i18n/strings';
import LangSwitch from '@/components/LangSwitch.astro';

interface Props {
  locale: Locale;
  alternates?: Record<Locale, string>;
}

const { locale, alternates } = Astro.props;
// The masthead renders on the legal pages too, where a bare `#what`
// scrolls nowhere. Anchors are therefore absolute to the home page.
const home = pathFor(locale);
const copy = t(locale);
---

<header class="masthead">
  <div class="wrap row">
    <a class="lockup" href={pathFor(locale)}>
      <img src="/compass-icon.png" alt="" />
      <span class="wm">{copy.masthead.pubName}</span>
      <span class="deck"><em>{copy.masthead.tagline}</em></span>
    </a>
    <nav>
      <a href={`${home}#what`}>{copy.masthead.navWhat}</a>
      <a href={`${home}#method`}>{copy.masthead.navMethod}</a>
      <a href={`${home}#brief`}>{copy.masthead.navBrief}</a>
      <a href={`${home}#contact`}>{copy.masthead.navContact}</a>
      <a class="sign-in" href="https://app.com-compass.com" rel="noopener">
        {copy.masthead.signIn}
        <svg width="11" height="11" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" />
        </svg>
      </a>
      <a class="cta" href={`${home}#contact`}>
        {copy.masthead.cta}
        <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 8h9M9 4.5 12.5 8 9 11.5" />
        </svg>
      </a>
      <LangSwitch locale={locale} alternates={alternates} />
    </nav>
  </div>
</header>

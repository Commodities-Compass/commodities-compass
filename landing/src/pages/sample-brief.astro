---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditorialSampleBrief from '@/components/sections/EditorialSampleBrief.astro';
import { t } from '@/i18n/strings';

const locale = 'fr' as const;
const copy = t(locale).sampleBriefPage;
---

<BaseLayout
  locale={locale}
  pathname="/sample-brief"
  title={copy.pageTitle}
  description={copy.pageDescription}
>
  <EditorialSampleBrief locale={locale} />
</BaseLayout>

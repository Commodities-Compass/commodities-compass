---
import BaseLayout from '@/layouts/BaseLayout.astro';
import EditorialDisclaimer from '@/components/sections/EditorialDisclaimer.astro';
import { t } from '@/i18n/strings';

const locale = 'en' as const;
const copy = t(locale).disclaimerPage;
---

<BaseLayout
  locale={locale}
  pathname="/en/disclaimer/"
  title={copy.pageTitle}
  description={copy.pageDescription}
>
  <EditorialDisclaimer locale={locale} />
</BaseLayout>

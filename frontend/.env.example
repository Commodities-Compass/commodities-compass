# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================

# Development Configuration
NODE_ENV=development
DEBUG=true
FRONTEND_PORT=5173

# Auth0 Configuration
AUTH0_DOMAIN=your-auth0-domain.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_API_AUDIENCE=https://api.commodities-compass.com
AUTH0_ISSUER=https://your-auth0-domain.auth0.com/
AUTH0_REDIRECT_URI=http://localhost:5173/dashboard

# API Configuration
API_BASE_URL=http://localhost:8000/api/v1
BACKEND_PORT=8000

# Sentry (PR-B wires this — same DSN as backend, single Sentry project, frontend tags itself)
# SENTRY_DSN=""
# Release tag — populated by CI via Docker build ARG; leave empty locally.
# GIT_COMMIT_SHA=""
# Organization Auth Token for source map upload — CI only, NEVER committed locally.
# SENTRY_AUTH_TOKEN=""

# =========================================================================
# Compass CC Landing — environment variables
# =========================================================================
# Copy this file to .env (gitignored) and uncomment what you want enabled.
# Vars prefixed `PUBLIC_` are exposed to the browser at build time.
# =========================================================================

# --- Analytics (Plausible) ---------------------------------------------
# When set, BaseLayout injects the Plausible script tag.
# When empty/unset, NO analytics script is loaded (zero third-party calls).
#
# Setup:
#   1. Create site on https://plausible.io with domain = com-compass.com
#   2. Uncomment + set the var
#   3. Rebuild + redeploy
#
# PUBLIC_PLAUSIBLE_DOMAIN=com-compass.com

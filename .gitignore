# Local-only runbooks, scripts, credentials (never committed)
.local/

# Sentry CLI config (contains auth token — never committed)
.sentryclirc
.sentryclirc.local

# Local scratch / one-off outputs (kept on disk, just not tracked)
tmp/
output/
mockup/

# Local-only docs subdirs (kept on disk, not in repo)
# Exception: the original R&D delivery packs under docs/algorithms/ ARE tracked
# (force-added). They are the only copy of what R&D shipped — the vendored code
# in backend/vendor/ is a derivative. Everything else here stays local by design.
docs/algorithms/
docs/user-stories/
docs/feature-proposals/
docs/presentations/

# HTML drafts / investigations (kept on disk, not in repo)
# Exception: brand bible HTML is intentionally tracked (referenced by CLAUDE.md)
docs/**/*.html
!docs/brand/**/*.html
backend/vendor/**/*.html

# git worktrees live under .claude/ but are separate checkouts — never commit them.
# They may hold gitignored artefacts (see .claude/rules/gitignored-artifacts-repatriation.md):
# audit before removing, never `git worktree remove` blind.
.claude/worktrees/
